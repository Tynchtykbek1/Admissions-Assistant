# Copy to .env and replace placeholders. Never commit .env.
# Required: choose exactly one provider and configure its key/model below.
LLM_PROVIDER=

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=your_openai_model_here

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=your_gemini_model_here

# Telegram bot
# Create a bot with BotFather and place its token here.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Local Python uses 127.0.0.1. Docker Compose overrides this with http://backend:8000.
BACKEND_URL=http://127.0.0.1:8000
BACKEND_CONNECT_TIMEOUT_SECONDS=10
BACKEND_READ_TIMEOUT_SECONDS=90
BACKEND_WRITE_TIMEOUT_SECONDS=15
BACKEND_POOL_TIMEOUT_SECONDS=10

# Retrieval defaults
SEMANTIC_TOP_K=5
SEMANTIC_SCORE_THRESHOLD=0.20
SEMANTIC_FALLBACK_SCORE_THRESHOLD=0.18
SEMANTIC_FALLBACK_SAFE_MINIMUM=0.15
CONTEXT_SCORE_MARGIN=0.12
HYBRID_SEMANTIC_CANDIDATE_LIMIT=15
HYBRID_LEXICAL_CANDIDATE_LIMIT=15
HYBRID_MAX_CONTEXT_CHUNKS=5

# Conversation history
CHAT_HISTORY_LIMIT=16
CHAT_HISTORY_CHARACTER_LIMIT=4000

# Upload and document cache limits
MAX_UPLOAD_SIZE_MB=15
DOCUMENT_CACHE_SIZE=8

# Logging
LOG_LEVEL=INFO
DEMO_MODE=false

# Embeddings and database. Compose overrides DATABASE_PATH with /data/admissions.db.
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DATABASE_PATH=admissions.db

# Required deployment choice: positive ID of an existing document with chunks.
# Upload/import the document first, then set its ID. No ID is selected implicitly.
SYSTEM_DOCUMENT_ID=

# Optional safety gate. Keep disabled except for an intentional live-provider smoke.
RUN_LIVE_LLM_TESTS=0
